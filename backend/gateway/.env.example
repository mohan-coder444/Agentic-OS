PORT=8000

# Base URL of the auth microservice (used by the /auth proxy in index.js)
AUTH_SERVICE_URL=http://localhost:8001
CHAT_SERVICE_URL=http://localhost:8002
AGENT_SERVICE_URL=http://localhost:8003

# Frontend URL allowed by CORS (Vite dev server)
FRONTEND_URL=http://localhost:5173

# Comma-separated CORS allowlist. Takes precedence over FRONTEND_URL when set.
# credentials:true forbids a "*" wildcard, so every allowed origin must be listed.
# Local only:
#   FRONTEND_URLS=http://localhost:5173
# Local + deployed frontend at the same time:
#   FRONTEND_URLS=http://localhost:5173,https://your-app.vercel.app
FRONTEND_URLS=http://localhost:5173
