PORT=8003
MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/cortexAI_agent

# ---------------------------------------------------------------------------
# LLM providers. The coding agent tries them in this order:
#   Bedrock (AWS) -> OpenCode Zen -> OpenRouter DeepSeek -> Mistral -> Groq
# Only ONE has to work. Bedrock is the highest-quality option.
# ---------------------------------------------------------------------------

# --- AWS Bedrock (recommended for coding agent) ---
# ABSK-format API key. AWS SDK auto-detects and uses Bearer auth (no SigV4).
# Get one at Bedrock console -> API keys.
AWS_BEARER_TOKEN_BEDROCK=ABSKBedrockAPIKey...
# eu-north-1 is Stockholm. Bedrock has its OWN region list, unrelated to
# your S3 region (AWS_REGION below is for S3).
BEDROCK_REGION=eu-north-1
# Cross-region inference profile IDs are prefixed eu. / us. They route to
# whichever region hosts the model. Same billing pool.
# Options in eu-north-1 (requires Model access grant in the console):
#   eu.anthropic.claude-sonnet-4-20250514-v1:0        (best design, ~$0.12/site)
#   eu.anthropic.claude-3-5-sonnet-20241022-v2:0      (great, ~$0.10/site)
#   eu.anthropic.claude-3-haiku-20240307-v1:0         (fast/cheap, ~$0.005/site)
#   eu.amazon.nova-pro-v1:0                            (good, ~$0.03/site)
#   eu.meta.llama3-3-70b-instruct-v1:0                 (solid, ~$0.006/site)
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_MAX_TOKENS=8000

# --- OpenRouter (DeepSeek coding) ---
# Free tier ~1M tokens then pay-as-you-go. Uses OpenAI-compatible protocol.
OPENROUTER_API_KEY=sk-or-v1-...
# maxTokens is checked against your BALANCE, not usage. Asking for more
# than you can afford 402s even if the actual output is short.
CODING_MAX_TOKENS=1000

# --- OpenCode Zen ---
# Requires billing setup, expected to 401 without a payment method.
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=gpt-5.3-codex
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1

# --- Mistral (embeddings + vision + coding fallback) ---
MISTRAL_API_KEY=

# --- Groq (routing + coding safety net, free tier) ---
GROQ_API_KEY=gsk_...

# ---------------------------------------------------------------------------
# Search + storage
# ---------------------------------------------------------------------------

# Tavily search agent (free 1000/month). Falls back to DuckDuckGo scrape.
TAVILY_API_KEY=tvly-...

# AWS S3 (artifacts bucket for generated PDFs, PPTs, images).
# NOTE: this is your S3 region, NOT Bedrock. They can differ.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-south-1
S3_BUCKET=cortex-ai-pdfs

# ---------------------------------------------------------------------------
# Auth + session shared with other services
# ---------------------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_string_same_as_auth_service
REDIS_URL=redis://redis:6379

# Chat service URL for saving user/assistant messages
CHAT_SERVICE_URL=http://chat:8002
