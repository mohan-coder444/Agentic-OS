PORT=8001
# Paste your MongoDB Atlas connection string, appending /auth for the collection.
MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/cortexAI_auth
# Secret used to sign session JWTs (generate a long random string)
JWT_SECRET=replace_with_a_long_random_string

# Cross-site session cookies. Leave false for local development.
#
# false -> sameSite=lax,  secure=false  (localhost:5173 -> localhost:8000 works)
# true  -> sameSite=none, secure=true   (required when the frontend is on a
#          DIFFERENT site than the API, e.g. *.vercel.app -> *.trycloudflare.com)
#
# Browsers reject sameSite=none without secure=true, so true only works when
# BOTH the frontend and the API are served over HTTPS.
CROSS_SITE_COOKIES=false
