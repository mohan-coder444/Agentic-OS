# URL of the API gateway (the ONLY backend URL the frontend talks to)
#
# Local:      http://localhost:8000
# Deployed:   the HTTPS URL that fronts your gateway, e.g. a Cloudflare Tunnel
#             https://something-random.trycloudflare.com
#
# Vite inlines VITE_* at BUILD time, not runtime. Changing this on the hosting
# platform requires a redeploy to take effect.
VITE_SERVER_URL=http://localhost:8000

# Firebase WEB app config — from Firebase console > Project Settings > Your apps (Web)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
